model ComplaintEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  societyId   String   @map("society_id") @db.Uuid
  complaintId String   @map("complaint_id") @db.Uuid
  /** CREATED | ASSIGNED | STATUS | COMMENT | RESOLVED */
  eventType   String   @map("event_type") @db.VarChar(32)
  fromStatus  String?  @map("from_status") @db.VarChar(32)
  toStatus    String?  @map("to_status") @db.VarChar(32)
  assignedToId String? @map("assigned_to_id") @db.Uuid
  note        String?
  actorId     String?  @map("actor_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  society   Society   @relation(fields: [societyId], references: [id], onDelete: Restrict)
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Restrict)

  @@index([complaintId, createdAt])
  @@index([societyId, createdAt(sort: Desc)])
  @@map("complaint_events")
}

model Amenity {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  societyId    String    @map("society_id") @db.Uuid
  code         String    @db.VarChar(64)
  name         String
  description  String?
  location     String?
  capacity     Int?
  /** Charge added to flat ledger / next invoice */
  hourlyCharge Decimal   @default(0) @map("hourly_charge") @db.Decimal(14, 2)
  slotMinutes  Int       @default(60) @map("slot_minutes")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  society  Society @relation(fields: [societyId], references: [id], onDelete: Restrict)
  bookings AmenityBooking[]

  @@unique([societyId, code])
  @@index([societyId, isActive])
  @@map("amenities")
}

model AmenityBooking {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  societyId     String    @map("society_id") @db.Uuid
  amenityId     String    @map("amenity_id") @db.Uuid
  memberId      String    @map("member_id") @db.Uuid
  flatId        String?   @map("flat_id") @db.Uuid
  startsAt      DateTime  @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime  @map("ends_at") @db.Timestamptz(6)
  chargeAmount  Decimal   @default(0) @map("charge_amount") @db.Decimal(14, 2)
  /** PENDING | CONFIRMED | CANCELLED | COMPLETED */
  statusCode    String    @default("CONFIRMED") @map("status_code") @db.VarChar(32)
  /** Link when charge posted to an invoice */
  invoiceId     String?   @map("invoice_id") @db.Uuid
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  society Society  @relation(fields: [societyId], references: [id], onDelete: Restrict)
  amenity Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)
  member  Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  flat    Flat?    @relation(fields: [flatId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([amenityId, startsAt, endsAt])
  @@index([societyId, memberId, startsAt])
  @@index([societyId, statusCode, startsAt])
  @@map("amenity_bookings")
}

model Poll {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  societyId   String    @map("society_id") @db.Uuid
  title       String
  description String?
  /** OPEN | CLOSED | DRAFT */
  statusCode  String    @default("OPEN") @map("status_code") @db.VarChar(32)
  startsAt    DateTime  @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(6)
  /** ONE | MULTI */
  voteMode    String    @default("ONE") @map("vote_mode") @db.VarChar(16)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  society Society @relation(fields: [societyId], references: [id], onDelete: Restrict)
  options PollOption[]
  votes   PollVote[]

  @@index([societyId, statusCode, endsAt])
  @@map("polls")
}

model PollOption {
  id        String @id @default(uuid()) @db.Uuid
  pollId    String @map("poll_id") @db.Uuid
  label     String
  sortOrder Int    @default(0) @map("sort_order")
  /** Denormalized counter — update in same TX as vote insert for fast tallies */
  voteCount Int    @default(0) @map("vote_count")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId, sortOrder])
  @@map("poll_options")
}

model PollVote {
  id        String   @id @default(uuid()) @db.Uuid
  pollId    String   @map("poll_id") @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  member Member     @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([pollId, memberId, optionId])
  @@index([pollId, memberId])
  @@map("poll_votes")
}

/** Chart of accounts per society — income/expense/asset/liability. */
model LedgerAccount {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  societyId  String    @map("society_id") @db.Uuid
  code       String    @db.VarChar(32)
  name       String
  /** ASSET | LIABILITY | INCOME | EXPENSE | EQUITY */
  typeCode   String    @map("type_code") @db.VarChar(16)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  society Society @relation(fields: [societyId], references: [id], onDelete: Restrict)
  lines   LedgerLine[]

  @@unique([societyId, code])
  @@index([societyId, typeCode, isActive])
  @@map("ledger_accounts")
}

/** Journal header — double-entry batch. */
model LedgerEntry {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  societyId   String   @map("society_id") @db.Uuid
  entryDate   DateTime @map("entry_date") @db.Date
  memo        String?
  /** MAINTENANCE | AMENITY | EXPENSE | TAX | ADJUSTMENT | PAYMENT */
  sourceType  String   @map("source_type") @db.VarChar(32)
  sourceId    String?  @map("source_id") @db.Uuid
  invoiceId   String?  @map("invoice_id") @db.Uuid
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  society Society @relation(fields: [societyId], references: [id], onDelete: Restrict)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  lines   LedgerLine[]

  @@index([societyId, entryDate(sort: Desc)])
  @@index([societyId, sourceType, sourceId])
  @@map("ledger_entries")
}

model LedgerLine {
  id        String  @id @default(uuid()) @db.Uuid
  entryId   String  @map("entry_id") @db.Uuid
  accountId String  @map("account_id") @db.Uuid
  debit     Decimal @default(0) @db.Decimal(14, 2)
  credit    Decimal @default(0) @db.Decimal(14, 2)

  entry   LedgerEntry   @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@index([entryId])
  @@map("ledger_lines")
}

/** GST / TDS / other tax events for treasurer exports. */
model TaxLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  societyId   String   @map("society_id") @db.Uuid
  /** GST | TDS | OTHER */
  taxType     String   @map("tax_type") @db.VarChar(16)
  periodMonth String   @map("period_month") @db.VarChar(7)
  taxableAmount Decimal @map("taxable_amount") @db.Decimal(14, 2)
  taxAmount   Decimal  @map("tax_amount") @db.Decimal(14, 2)
  referenceNo String?  @map("reference_no")
  sourceType  String?  @map("source_type") @db.VarChar(32)
  sourceId    String?  @map("source_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  society Society @relation(fields: [societyId], references: [id], onDelete: Restrict)

  @@index([societyId, taxType, periodMonth])
  @@map("tax_logs")
}

