// ═══════════════════════════════════════════════════════════════════
// MyGate-style pillars — Gate, Helpdesk/Amenities, Compliance, Ledger
// Hot-path indexes favour OTP/QR validation, open tickets, open panic.
// ═══════════════════════════════════════════════════════════════════

/** Pre-approved guest / delivery pass (OTP or QR). Guard validates in <50ms via unique active code. */
model VisitorPass {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  societyId    String    @map("society_id") @db.Uuid
  memberId     String    @map("member_id") @db.Uuid
  flatId       String?   @map("flat_id") @db.Uuid
  /** GUEST | DELIVERY | CAB | STAFF_INVITE */
  categoryCode String    @default("GUEST") @map("category_code") @db.VarChar(32)
  guestName    String    @map("guest_name")
  guestPhone   String?   @map("guest_phone")
  vehicleNo    String?   @map("vehicle_no")
  /** Plain 6-digit for share; look up via pass_code_hash or pass_code for active rows */
  passCode     String    @map("pass_code") @db.VarChar(12)
  qrToken      String    @unique @map("qr_token")
  validFrom    DateTime  @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime  @map("valid_until") @db.Timestamptz(6)
  maxEntries   Int       @default(1) @map("max_entries")
  entriesUsed  Int       @default(0) @map("entries_used")
  /** ACTIVE | USED | EXPIRED | REVOKED */
  statusCode   String    @default("ACTIVE") @map("status_code") @db.VarChar(32)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  society  Society @relation(fields: [societyId], references: [id], onDelete: Restrict)
  member   Member  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  flat     Flat?   @relation(fields: [flatId], references: [id], onDelete: SetNull)
  visitors Visitor[]
  gateEvents GateEvent[]

  @@unique([societyId, passCode])
  @@index([societyId, statusCode, validUntil])
  @@index([societyId, memberId, createdAt])
  @@map("visitor_passes")
}

/** Append-only gate timeline — denormalized flat/guest for guard list without joins. */
model GateEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  societyId    String   @map("society_id") @db.Uuid
  passId       String?  @map("pass_id") @db.Uuid
  visitorId    String?  @map("visitor_id") @db.Uuid
  staffId      String?  @map("staff_id") @db.Uuid
  /** ENTRY | EXIT | DENY | OVERRIDE | DELIVERY_HANDOFF */
  eventType    String   @map("event_type") @db.VarChar(32)
  categoryCode String?  @map("category_code") @db.VarChar(32)
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  flatLabel    String?  @map("flat_label")
  personName   String?  @map("person_name")
  vehicleNo    String?  @map("vehicle_no")
  photoUrl     String?  @map("photo_url")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  society Society     @relation(fields: [societyId], references: [id], onDelete: Restrict)
  pass    VisitorPass? @relation(fields: [passId], references: [id], onDelete: SetNull)
  staff   StaffProfile? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([societyId, createdAt(sort: Desc)])
  @@index([societyId, eventType, createdAt(sort: Desc)])
  @@map("gate_events")
}

