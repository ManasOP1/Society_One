# SocietyOne Admin Console (Next.js)

# ─── Local development ───────────────────────────────────────────────
# Browser calls same-origin /api/v1 — Next.js rewrites proxy to Nest.
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:4000

# Optional: point local Next at the live Render API (no local Nest needed):
# API_PROXY_TARGET=https://admin-society-one.onrender.com

# ─── Vercel production (REQUIRED) ────────────────────────────────────
# ─── Vercel production (REQUIRED) ────────────────────────────────────
# Prefer same-origin /api/v1 (Next route handler proxies to Nest on Render):
#   NEXT_PUBLIC_API_BASE_URL = /api/v1
#   API_PROXY_TARGET         = https://admin-society-one.onrender.com
#
# On Vercel, Fly.io / localhost API_PROXY_TARGET values are ignored and
# traffic is forced to https://admin-society-one.onrender.com.
#
# Direct Render URL (requires CORS_ORIGINS on Render to include this admin URL):
#   NEXT_PUBLIC_API_BASE_URL = https://admin-society-one.onrender.com/api/v1
#
# After changing Vercel env vars: Redeploy the admin project.
#
# Admin does NOT need DATABASE_URL, JWT secrets, or Supabase keys —
# those belong only on the Nest API (Render).
